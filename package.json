{
  "name": "kino",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:mobile": "pnpm --filter @kino/mobile start",
    "dev:web": "pnpm --filter @kino/web dev",
    "biome": "biome check .",
    "biome:fix": "biome check --write .",
    "build": "pnpm build:web",
    "build:web": "pnpm --filter @kino/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "pretest": "node --test scripts/*.test.mjs && node scripts/validate-test-scripts.mjs .",
    "test": "pnpm -r --if-present test",
    "check": "pnpm biome check . && pnpm lint && pnpm typecheck && pnpm test && pnpm build:web",
    "format": "biome format --write .",
    "start": "pnpm dev:mobile",
    "android": "pnpm --filter @kino/mobile android",
    "ios": "pnpm --filter @kino/mobile ios",
    "web": "pnpm dev:web",
    "mobile:web": "pnpm --filter @kino/mobile web",
    "native:prebuild": "pnpm --filter @kino/mobile native:prebuild",
    "quality": "pnpm biome check . && pnpm lint && pnpm typecheck && pnpm test && pnpm build:web",
    "quality:fix": "node scripts/quality-fix.mjs",
    "quality:web": "node scripts/quality-web.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@tolgee/cli": "^2.20.0"
  }
}
