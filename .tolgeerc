{
  "$schema": "https://docs.tolgee.io/cli-schema.json",
  "apiUrl": "http://localhost:8989",
  "projectId": 34,
  "format": "JSON_I18NEXT",
  "strictNamespace": false,
  "extractor": "./scripts/tolgee-extractor.mjs",
  "patterns": [
    "./apps/web/**/*.ts?(x)",
    "./packages/**/*.ts?(x)"
  ],
  "pull": {
    "path": "./packages/i18n/generated",
    "emptyDir": true
  },
  "sync": {
    "removeUnused": false
  }
}
